# ============================================
# Unity 项目 .gitignore（官方模板精简版）
# 作用：让 Git 只跟踪源码，不跟踪几百 MB 的缓存
# ============================================

# Unity 自动生成的缓存目录（绝对不要提交）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# 自动生成的 IDE 工程文件
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 崩溃报告
sysinfo.txt

# 构建产物（成品放 Releases 或 itch.io，不进源码仓库）
*.apk
*.aab
*.unitypackage
*.app

# VS Code / Rider / Visual Studio
.vs/
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db
*.swp
